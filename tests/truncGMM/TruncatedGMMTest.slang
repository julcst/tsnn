// GPU probes for tests/truncGMM/test_truncated_gmm.py.
// Kept separate from the implementation so this file only exercises its public math.
import TSNN.Mixtures.TruncatedGMM;
import TSNN.Mixtures.GaussianHelpers;
import TSNN.Optimizers.Adam;
import TSNN.Utils.PCG32;

// Sixteen components exercise a realistic fixed-size AD path while avoiding
// the enormous reverse shader generated by a 32-way ForceUnroll.
static const uint COMPONENTS = 16;
static const uint PARAM_COUNT = COMPONENTS * 5;

StructuredBuffer<float> gInputs;
RWStructuredBuffer<float> gOutputs;

// This differentiable-pointer wrapper writes parameter-major gradients for training
// samples. evalNLL copies it into the GMM's fixed-size float array.
struct ParamBufferGrad : IDifferentiablePtrType
{
    typealias Differential = ParamBufferGrad;
    RWStructuredBuffer<float> values;
    uint row;
    __init(RWStructuredBuffer<float> values, uint row) { this.values = values; this.row = row; }
}

struct ParamBuffer : IDifferentiablePtrType, IArray<float>
{
    typealias Differential = ParamBufferGrad;
    StructuredBuffer<float> values;
    uint row;
    __init(StructuredBuffer<float> values, uint row) { this.values = values; this.row = row; }
    int getCount() { return PARAM_COUNT; }
    __subscript(int index) -> float { [Differentiable] get { return loadParam(this, index); } }
}

[BackwardDerivative(loadParam_bwd)]
float loadParam(ParamBuffer params, int index)
{
    return params.values[index];
}

void loadParam_bwd(DifferentialPtrPair<ParamBuffer> params, int index, float dOut)
{
    params.d.values[uint(index) * gCount + params.d.row] += dOut;
}

[numthreads(64, 1, 1)]
void cdfMain(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= gCount) return;
    float x = gInputs[3 * i + 0];
    float mean = gInputs[3 * i + 1];
    float logSigma = gInputs[3 * i + 2];
    gOutputs[2 * i + 0] = normalCDF(x, mean, logSigma);
    gOutputs[2 * i + 1] = normalCDFInverse(x, mean, logSigma);
}

[Differentiable]
float componentPDF(float2 x, float2 mean, float2 logSigma)
{
    return exp(logTruncGaussianPDF(x, mean, logSigma));
}

// Exercise all six inputs and the exp(logPDF) chain rule, including dPDF/dx.
[numthreads(64, 1, 1)]
void componentGradMain(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= gCount) return;
    var x = diffPair(float2(gInputs[6*i], gInputs[6*i+1]), float2(0.0));
    var mean = diffPair(float2(gInputs[6*i+2], gInputs[6*i+3]), float2(0.0));
    var logSigma = diffPair(float2(gInputs[6*i+4], gInputs[6*i+5]), float2(0.0));
    gOutputs[7*i] = componentPDF(x.p, mean.p, logSigma.p);
    bwd_diff(componentPDF)(x, mean, logSigma, 1.0);
    for (uint d = 0; d < 2; ++d)
    {
        gOutputs[7*i+1+d] = x.d[d];
        gOutputs[7*i+3+d] = mean.d[d];
        gOutputs[7*i+5+d] = logSigma.d[d];
    }
}

// A sixteen-component model exercises mixture-weight normalization as well as
// the full truncated-GMM evaluator. One parameter vector is
// differentiated for every target sample; Adam averages the per-sample gradients.
[numthreads(64, 1, 1)]
void nllGradMain(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= gCount) return;
    float2 x = float2(gInputs[2 * i], gInputs[2 * i + 1]);
    [ForceUnroll]
    for (uint j = 0; j < PARAM_COUNT; ++j)
        gParamGrads[j * gCount + i] = 0.0;
    ParamBuffer params = ParamBuffer(gParams, i);
    ParamBufferGrad dparams = ParamBufferGrad(gParamGrads, i);
    float nll = evalNLL(params, x);
    float2 dx = 0.0;
    var dparamsPair = DifferentialPtrPair<ParamBuffer>(params, dparams);
    var dxPair = diffPair(x, dx);
    bwd_diff(evalNLL)(dparamsPair, dxPair, 1.0);

    gOutputs[i] = nll;
}

// Accumulate in thread-local registers, then write each gradient once using
// a parameter-major layout so neighboring lanes write neighboring addresses.
[numthreads(64, 1, 1)]
void nllArrayGradMain(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= gCount) return;
    float values[PARAM_COUNT] = {};
    float zeros[PARAM_COUNT] = {};
    [ForceUnroll]
    for (uint j = 0; j < PARAM_COUNT; ++j)
        values[j] = gParams[j];
    float2 x = float2(gInputs[2 * i], gInputs[2 * i + 1]);
    var params = diffPair(values, zeros);
    var point = diffPair(x, float2(0.0));
    gOutputs[i] = evalArrayNLL(values, x);
    bwd_diff(evalArrayNLL)(params, point, 1.0);
    [ForceUnroll]
    for (uint j = 0; j < PARAM_COUNT; ++j)
        gParamGrads[j * gCount + i] = params.d[j];
}

[Differentiable]
float evalArrayNLL(float values[PARAM_COUNT], float2 x)
{
    TruncatedGMM<COMPONENTS> gmm;
    return -gmm.eval(values, x);
}

[Differentiable]
float evalNLL(ParamBuffer params, float2 x)
{
    TruncatedGMM<COMPONENTS> gmm;
    float values[PARAM_COUNT] = {};
    [ForceUnroll]
    for (uint j = 0; j < PARAM_COUNT; ++j)
        values[j] = params[j];
    return -gmm.eval(values, x);
}

[numthreads(64, 1, 1)]
void evalMain(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= gCount) return;
    float2 x = float2(gInputs[2 * i], gInputs[2 * i + 1]);
    float params[PARAM_COUNT] = {};
    [ForceUnroll]
    for (uint j = 0; j < PARAM_COUNT; ++j)
        params[j] = gParams[j];
    TruncatedGMM<COMPONENTS> gmm;
    gOutputs[i] = exp(gmm.eval(params, x));
}

// Compile and execute the same fixed-size API with half inputs. This mirrors
// the output of a half-precision network before it is consumed by the GMM.
[numthreads(64, 1, 1)]
void halfEvalMain(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= gCount) return;
    float2 x = float2(gInputs[2 * i], gInputs[2 * i + 1]);
    half params[PARAM_COUNT] = {};
    [ForceUnroll]
    for (uint j = 0; j < PARAM_COUNT; ++j)
        params[j] = half(gParams[j]);
    TruncatedGMM<COMPONENTS> gmm;
    gOutputs[i] = exp(gmm.eval(params, x));
}

[numthreads(64, 1, 1)]
void sampleMain(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= gCount) return;
    float params[PARAM_COUNT] = {};
    [ForceUnroll]
    for (uint j = 0; j < PARAM_COUNT; ++j)
        params[j] = gParams[j];
    TruncatedGMM<COMPONENTS> gmm;
    PCG32 rng = PCG32(uint64_t(i + 1), uint64_t(17));
    float2 x = gmm.sample(params, rng);
    gOutputs[2 * i] = x.x;
    gOutputs[2 * i + 1] = x.y;
}

cbuffer CB
{
    uint gCount;
}

StructuredBuffer<float> gParams;
RWStructuredBuffer<float> gParamGrads;

RWStructuredBuffer<float> gTrainParams;
RWStructuredBuffer<float> gMoment1;
RWStructuredBuffer<float> gMoment2;

cbuffer AdamCB
{
    uint gBatchSize;
    float gCurrentStep;
    float gLearningRate;
}

[numthreads(64, 1, 1)]
void adamMain(uint3 tid : SV_DispatchThreadID)
{
    uint parameterIndex = tid.x;
    if (parameterIndex >= PARAM_COUNT) return;

    float gradient = 0.0;
    for (uint sampleIndex = 0; sampleIndex < gBatchSize; ++sampleIndex)
        gradient += gParamGrads[parameterIndex * gBatchSize + sampleIndex];
    gradient /= float(gBatchSize);

    vector<float, 1> parameter = vector<float, 1>(gTrainParams[parameterIndex]);
    vector<float, 1> moment1 = vector<float, 1>(gMoment1[parameterIndex]);
    vector<float, 1> moment2 = vector<float, 1>(gMoment2[parameterIndex]);
    let adam = Adam(gCurrentStep, AdamConfig(gLearningRate));
    adam.step(parameter, moment1, moment2, vector<float, 1>(gradient));
    uint componentField = parameterIndex % 5;
    if (componentField == 1 || componentField == 2)
        parameter[0] = clamp(parameter[0], -0.5, 1.5);
    else if (componentField == 3 || componentField == 4)
        parameter[0] = clamp(parameter[0], -3.0, 0.5);
    gTrainParams[parameterIndex] = parameter[0];
    gMoment1[parameterIndex] = moment1[0];
    gMoment2[parameterIndex] = moment2[0];
}
